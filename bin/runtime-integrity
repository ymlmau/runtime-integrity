#!/usr/bin/env php
<?php

use YmlMau\RuntimeIntegrity\Config;
use YmlMau\RuntimeIntegrity\Crypto\CryptoFactory;
use YmlMau\RuntimeIntegrity\Integrity\Baseline;
use YmlMau\RuntimeIntegrity\Integrity\IntegrityChecker;
use YmlMau\RuntimeIntegrity\StateStore;
use YmlMau\RuntimeIntegrity\Support\CanonicalJson;

$autoloadCandidates = [
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../vendor/autoload.php',
];
foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

function ri_arg($name, $default = null)
{
    global $argv;
    $prefix = '--' . $name . '=';
    foreach ($argv as $arg) {
        if (strpos($arg, $prefix) === 0) {
            return substr($arg, strlen($prefix));
        }
    }
    return $default;
}

function ri_root()
{
    $root = ri_arg('root', getcwd());
    $real = realpath($root);
    return $real !== false ? $real : $root;
}

function ri_seed_config($root)
{
    $config = Config::defaults();
    $composerPath = $root . DIRECTORY_SEPARATOR . 'composer.json';
    if (!is_file($composerPath)) {
        return $config;
    }
    $raw = @file_get_contents($composerPath);
    $composer = $raw !== false ? json_decode($raw, true) : null;
    if (is_array($composer) && !empty($composer['extra']['ymlmau-runtime-integrity']) && is_array($composer['extra']['ymlmau-runtime-integrity'])) {
        $config = Config::merge($config, $composer['extra']['ymlmau-runtime-integrity']);
    }
    return $config;
}

function ri_runtime_document($root)
{
    $statePath = $root . DIRECTORY_SEPARATOR . '.runtime-integrity';
    if (!is_file($statePath)) {
        return null;
    }
    return (new StateStore($statePath))->read();
}

function ri_effective_config($root)
{
    $document = ri_runtime_document($root);
    if (is_array($document) && !empty($document['config']) && is_array($document['config'])) {
        return $document['config'];
    }
    return ri_seed_config($root);
}

function ri_key_contents($path)
{
    if (!$path || !is_file($path)) {
        throw new RuntimeException('Key file is required and must exist.');
    }
    $value = @file_get_contents($path);
    if ($value === false) {
        throw new RuntimeException('Unable to read key file.');
    }
    return trim($value);
}

function ri_product_matches(array $baseline, array $config)
{
    $baselineProductId = isset($baseline['payload']['product_id']) ? $baseline['payload']['product_id'] : null;
    $configuredProductId = isset($config['product_id']) ? $config['product_id'] : null;
    return $baselineProductId && $configuredProductId && hash_equals((string) $configuredProductId, (string) $baselineProductId);
}

$command = isset($argv[1]) ? $argv[1] : null;
if (!$command || in_array($command, ['-h', '--help', 'help'], true)) {
    fwrite(STDOUT, 'Runtime Integrity ' . Config::MONITOR_VERSION . "\n\n");
    fwrite(STDOUT, "Commands:\n");
    fwrite(STDOUT, "  build  --root=PATH --product=ID --build=ID --algorithm=ed25519 --private-key=PATH [--public-key=PATH]\n");
    fwrite(STDOUT, "  verify --root=PATH [--baseline=PATH] [--algorithm=...] [--public-key=PATH]\n");
    fwrite(STDOUT, "  doctor --root=PATH\n");
    exit(0);
}

try {
    $root = ri_root();

    if ($command === 'build') {
        $config = ri_seed_config($root);
        $productId = ri_arg('product', isset($config['product_id']) ? $config['product_id'] : null);
        $buildId = ri_arg('build');
        $algorithm = ri_arg('algorithm', !empty($config['developer_auth']['algorithm']) ? $config['developer_auth']['algorithm'] : 'ed25519');
        $privateKey = ri_key_contents(ri_arg('private-key'));
        if (!$productId || !$buildId) {
            throw new RuntimeException('Both --product and --build are required (product may come from composer extra).');
        }

        $provider = CryptoFactory::forAlgorithm($algorithm);
        $checker = new IntegrityChecker();
        $files = $checker->scan($root, $config['manifest']['include'], $config['manifest']['exclude']);
        $payload = Baseline::buildPayload($productId, $buildId, $files);
        $message = CanonicalJson::encode($payload);
        $signature = $provider->sign($message, $privateKey);

        $publicKeyPath = ri_arg('public-key');
        $trustedPublicKey = $publicKeyPath
            ? ri_key_contents($publicKeyPath)
            : (!empty($config['developer_auth']['public_key']) ? $config['developer_auth']['public_key'] : null);
        if ($trustedPublicKey !== null && !$provider->verify($message, $signature, $trustedPublicKey)) {
            throw new RuntimeException('The private key does not match the configured/provided developer public key. Baseline was not written.');
        }

        $baseline = [
            'payload' => $payload,
            'signature' => [
                'algorithm' => $algorithm,
                'value' => $signature,
            ],
        ];
        $json = CanonicalJson::encode($baseline) . PHP_EOL;
        $out = ri_arg('out', $root . DIRECTORY_SEPARATOR . '.runtime-integrity.baseline');
        if (function_exists('gzencode')) {
            $json = gzencode($json, 9);
        }
        if (@file_put_contents($out, $json) === false) {
            throw new RuntimeException('Unable to write baseline.');
        }
        fwrite(STDOUT, "BASELINE_WRITTEN {$out}\n");
        fwrite(STDOUT, 'PRODUCT ' . $productId . PHP_EOL);
        fwrite(STDOUT, 'BUILD ' . $buildId . PHP_EOL);
        fwrite(STDOUT, 'FILES ' . count($files) . PHP_EOL);
        fwrite(STDOUT, 'ROOT_HASH ' . $payload['root_hash'] . PHP_EOL);
        exit(0);
    }

    if ($command === 'verify') {
        $config = ri_effective_config($root);
        $baselinePath = ri_arg('baseline', $root . DIRECTORY_SEPARATOR . '.runtime-integrity.baseline');
        $algorithm = ri_arg('algorithm', isset($config['developer_auth']['algorithm']) ? $config['developer_auth']['algorithm'] : null);
        $publicKeyPath = ri_arg('public-key');
        $publicKey = $publicKeyPath
            ? ri_key_contents($publicKeyPath)
            : (isset($config['developer_auth']['public_key']) ? $config['developer_auth']['public_key'] : null);
        $baseline = Baseline::load($baselinePath);
        if (!Baseline::verify($baseline, $algorithm, $publicKey)) {
            fwrite(STDOUT, "BASELINE_INVALID\n");
            exit(2);
        }
        if (!ri_product_matches($baseline, $config)) {
            fwrite(STDOUT, "BASELINE_PRODUCT_MISMATCH\n");
            exit(2);
        }
        $checker = new IntegrityChecker();
        $observed = $checker->scan($root, $config['manifest']['include'], $config['manifest']['exclude']);
        $comparison = $checker->compare($baseline['payload']['files'], $observed);
        if ($comparison['clean']) {
            fwrite(STDOUT, "CLEAN\n");
            exit(0);
        }
        fwrite(STDOUT, "MODIFIED\n");
        fwrite(STDOUT, 'MODIFIED_COUNT ' . count($comparison['modified']) . PHP_EOL);
        fwrite(STDOUT, 'ADDED_COUNT ' . count($comparison['added']) . PHP_EOL);
        fwrite(STDOUT, 'DELETED_COUNT ' . count($comparison['deleted']) . PHP_EOL);
        exit(3);
    }

    if ($command === 'doctor') {
        $issues = [];
        $notes = [];

        if (version_compare(PHP_VERSION, '7.4.0', '<')) {
            $issues[] = 'PHP_VERSION_UNSUPPORTED';
        } else {
            $notes[] = 'PHP_OK ' . PHP_VERSION;
        }

        $extensionsPath = $root . DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR . 'yiisoft' . DIRECTORY_SEPARATOR . 'extensions.php';
        if (!is_file($extensionsPath)) {
            $issues[] = 'YII_EXTENSIONS_FILE_MISSING';
        } else {
            $extensionsRaw = @file_get_contents($extensionsPath);
            if ($extensionsRaw === false || strpos($extensionsRaw, 'YmlMau\\\\RuntimeIntegrity\\\\Bootstrap') === false) {
                $issues[] = 'YII_EXTENSION_NOT_REGISTERED';
            } else {
                $notes[] = 'YII_BOOTSTRAP_REGISTERED';
            }
        }

        $state = null;
        $statePath = $root . DIRECTORY_SEPARATOR . '.runtime-integrity';
        if (!is_file($statePath)) {
            $issues[] = 'STATE_NOT_INITIALIZED';
        } else {
            try {
                $state = (new StateStore($statePath))->read();
                if ((int) (isset($state['schema']) ? $state['schema'] : 0) !== Config::SCHEMA_VERSION) {
                    $issues[] = 'STATE_SCHEMA_UNSUPPORTED';
                }
                if (empty($state['identity']['installation_id'])) {
                    $issues[] = 'IDENTITY_MISSING';
                } else {
                    $notes[] = 'IDENTITY_OK ' . $state['identity']['installation_id'];
                }
            } catch (Throwable $e) {
                $issues[] = 'STATE_CORRUPT';
            }
        }

        $config = is_array($state) && !empty($state['config']) && is_array($state['config'])
            ? $state['config']
            : ri_seed_config($root);

        if (empty($config['product_id'])) {
            $issues[] = 'PRODUCT_ID_MISSING';
        } else {
            $notes[] = 'PRODUCT_ID_OK ' . $config['product_id'];
        }
        if (empty($config['developer_auth']['algorithm']) || empty($config['developer_auth']['public_key'])) {
            $issues[] = 'DEVELOPER_AUTH_MISSING';
        } else {
            $algorithm = $config['developer_auth']['algorithm'];
            if ($algorithm === 'ed25519') {
                if (\YmlMau\RuntimeIntegrity\Crypto\SodiumEd25519Provider::isAvailable()) {
                    $notes[] = 'CRYPTO_VERIFY_OK ed25519';
                } else {
                    $issues[] = 'CRYPTO_VERIFY_UNAVAILABLE ed25519';
                }
            } elseif ($algorithm === 'rsa-sha256') {
                if (\YmlMau\RuntimeIntegrity\Crypto\OpenSslProvider::isVerificationAvailable()) {
                    $notes[] = 'CRYPTO_VERIFY_OK rsa-sha256';
                } else {
                    $issues[] = 'CRYPTO_VERIFY_UNAVAILABLE rsa-sha256';
                }
            } else {
                $issues[] = 'DEVELOPER_AUTH_ALGORITHM_UNSUPPORTED';
            }
        }
        if (!Config::validateTransport($config['email'], 'relay_url')) {
            $issues[] = 'EMAIL_CONFIG_INVALID';
        }
        if (!Config::validateTransport($config['api'], 'url')) {
            $issues[] = 'API_CONFIG_INVALID';
        }
        $anyHttpTransport = !empty($config['email']['enabled']) || !empty($config['api']['enabled']);
        if ($anyHttpTransport && !function_exists('curl_init') && !(bool) ini_get('allow_url_fopen')) {
            $issues[] = 'HTTP_CLIENT_UNAVAILABLE';
        }

        $baselinePath = $root . DIRECTORY_SEPARATOR . '.runtime-integrity.baseline';
        if (!is_file($baselinePath)) {
            $issues[] = 'BASELINE_MISSING';
        } else {
            try {
                $baseline = Baseline::load($baselinePath);
                $algorithm = isset($config['developer_auth']['algorithm']) ? $config['developer_auth']['algorithm'] : null;
                $publicKey = isset($config['developer_auth']['public_key']) ? $config['developer_auth']['public_key'] : null;
                if (!Baseline::verify($baseline, $algorithm, $publicKey)) {
                    $issues[] = 'BASELINE_INVALID';
                } elseif (!ri_product_matches($baseline, $config)) {
                    $issues[] = 'BASELINE_PRODUCT_MISMATCH';
                } else {
                    $notes[] = 'BASELINE_OK ' . (isset($baseline['payload']['build_id']) ? $baseline['payload']['build_id'] : 'unknown-build');
                }
            } catch (Throwable $e) {
                $issues[] = 'BASELINE_INVALID';
            }
        }

        foreach ($notes as $note) {
            fwrite(STDOUT, $note . PHP_EOL);
        }
        if (!$issues) {
            fwrite(STDOUT, "DOCTOR_OK\n");
            exit(0);
        }
        foreach (array_values(array_unique($issues)) as $issue) {
            fwrite(STDOUT, 'ISSUE ' . $issue . PHP_EOL);
        }
        exit(4);
    }

    throw new RuntimeException('Unknown command: ' . $command);
} catch (Throwable $e) {
    fwrite(STDERR, '[runtime-integrity] ' . $e->getMessage() . PHP_EOL);
    exit(1);
}
