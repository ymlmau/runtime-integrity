{
  "repositories": [
    {
      "type": "path",
      "url": "C:/packages/runtime-integrity",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "ymlmau/runtime-integrity": "1.1.0"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "extra": {
    "ymlmau-runtime-integrity": {
      "product_id": "REEMPLAZAR-POR-ID-DEL-PRODUCTO",
      "developer_auth": {
        "algorithm": "ed25519",
        "public_key": "REEMPLAZAR-POR-CLAVE-PUBLICA"
      },
      "email": {
        "enabled": false,
        "relay_url": null
      },
      "api": {
        "enabled": false,
        "url": null
      },
      "privacy": {
        "include_hostname": false
      }
    }
  }
}
